classDiagram
    direction TB
    %% Implemented foundation only, 2026-11-09. Frontend removed; frameworks are build dependencies.
    %% See implementation-status.md for delivery boundaries, Sprint1.md for target rules.
    class Main {
        +main(String[] args) void
    }
    class GameController {
        -GameState state
        -RuleValues rules
        -ContentCatalog content
        +snapshot() GameState
        +completeOpening() Result
        +showLesson() Lesson
        +lessonChoice(String choice) Result
        +completeReview() Result
        +otherClasses(boolean reviseIcs) Result
        +hubActivity(String id) Result
        +sleepImmediatelyAfterSchool() Result
        +beginNextDay() Result
        +skipClass(boolean excused) Result
        +scheduleMakeup(int missedDay, int lessonDay) Result
        +startAssessment() AssessmentView
        +recordEvaluatedSubmission(double mark, String evidence) Result
        +recordSelfEstimate(double mark, double cost, double delta) Result
        +caughtCheating(boolean serious) Result
        +applyOfficialFeedback(String id, StatChange effect) Result
        +resolveMidterm(String choice) Result
    }
    class GameState {
        -String name
        -int day
        -DayPeriod period
        -StudentState student
        -GradeBook grades
        -RunProgress run
        -Status status
        -boolean openingCompleted
        -boolean lessonShown
        -boolean nextMorningBonus
        -double nextMorningSanBonus
        -List~TimedEffect~ effects
        -Map makeups
        -Set missedAssessments
        -Set seriousCheating
        -Set feedbackApplied
        -Map estimates
        -Set rewards
        -Map relationships
        -ActiveAssessment active
        +currentCourse() DayPlan
        +effectiveSan() double
        +xpMultiplier() double
        +canSave() boolean
    }
    class StudentState {
        <<record>>
        +double hp
        +double san
        +double codingVibe
        +List~Double~ unitKnowledge
    }
    class StatChange {
        <<record>>
        +double hp
        +double san
        +double codingVibe
        +List~Double~ unitKnowledge
        +none() StatChange
        +learning(int unit, double vibe, double knowledge, double san) StatChange
    }
    class TimedEffect {
        <<record>>
        +String id
        +int firstDay
        +int lastDay
        +double sanDelta
        +double xpMultiplier
        +activeOn(int day) boolean
    }
    class RuleValues {
        <<record>>
        +Double lateNightSanReduction
        +Double lateNightXpMultiplier
        +Double earlySleepSanBonus
        +Double makeupSanReduction
        +Double caughtCheatingSanReduction
        +TutorialAbsences tutorialAbsences
        +pending() RuleValues
    }
    class SchoolCalendar {
        +days() List~DayPlan~
        +day(int number) DayPlan
        +makeupCandidates(int missedDay) List~Integer~
    }
    class DayPlan {
        <<record>>
        +int day
        +CourseType course
        +int unit
        +boolean tutorial
        +assessmentId() String
    }
    class DayPeriod {
        <<enumeration>>
        MORNING_BONUS
        ICS_CLASS
        OTHER_CLASSES
        AFTER_SCHOOL
        EVENING
        LATE_NIGHT
        DAY_END
        +activityUnits() double
        +next() DayPeriod
    }
    class CourseType {
        <<enumeration>>
        LESSON
        LAB
        UNIT_TEST
        REVIEW
        MIDTERM
        FINAL
        +isAssessment() boolean
        +isMajor() boolean
        +isTermAssessment() boolean
    }
    class ContentCatalog {
        -Map lessons
        -Map hub
        -Map reviews
        -Map banks
        -Map sampleCounts
        -StatChange otherClassRevision
        +pending() ContentCatalog
        +lesson(int day) Lesson
        +hub(String id) StatChange
        +review(int day) StatChange
        +otherRevision() StatChange
        +questions(DayPlan original, RandomGenerator random) List~Question~
    }
    class Lesson {
        <<nested record>>
        +String text
        +Interaction interaction
        +Map choices
    }
    class Question {
        <<nested record>>
        +String id
        +String prompt
    }
    class GradeBook {
        -Map records
        -int unexcusedAbsences
        +records() List~AssessmentRecord~
        +record(String id) AssessmentRecord
        +absenceDeductionPoints() int
        +finalPercentage(double midtermWeight, double participationPercent) double
    }
    class AssessmentRecord {
        -String id
        -CourseType type
        -int submittedDay
        -int returnDay
        -List~String~ questionIds
        -boolean makeup
        -double score
        -boolean released
        -String evidence
        +officialScore() OptionalDouble
    }
    class ActiveAssessment {
        <<nested record>>
        +DayPlan original
        +List~Question~ questions
        +boolean makeup
    }
    class RunProgress {
        <<record>>
        +int retakesUsed
        +remainingRetakes() int
        +consumeRetake() RunProgress
        +rewardsForNewPlaythrough(Set owned, Set selected) Set
    }
    class SaveManager {
        +saveAtDayEnd(GameState state, Path destination) void
        +load(Path path) GameState
    }
    class JavaAssessmentRunner {
        -Path jdk
        -Limits limits
        +evaluate(String className, String source, List tests, List rubric) Report
    }
    class StyleRule {
        <<interface>>
        +id() String
        +inspect(String source) Finding
    }
    class LineLength {
        <<nested record>>
        +String id
        +int maximum
        +inspect(String source) Finding
    }
    class PendingRuleException {
        +ruleId() String
    }

    GameController --> GameState : copies then commits atomically
    GameController --> RuleValues : explicit policy inputs
    GameController --> ContentCatalog : supplied content
    GameController ..> PendingRuleException : missing decision
    GameState *-- StudentState
    GameState *-- GradeBook
    GameState *-- RunProgress
    GameState *-- TimedEffect
    GameState --> DayPeriod
    GameState --> SchoolCalendar : static day lookup
    GameState --> ActiveAssessment
    SchoolCalendar "1" *-- "40" DayPlan
    DayPlan --> CourseType
    ContentCatalog *-- Lesson
    ContentCatalog *-- Question
    ContentCatalog --> StatChange
    Lesson --> StatChange : configured choices
    GameController --> StatChange
    GradeBook *-- AssessmentRecord
    AssessmentRecord --> CourseType
    ActiveAssessment --> DayPlan
    ActiveAssessment --> Question
    SaveManager ..> GameState : versioned day-end snapshot
    JavaAssessmentRunner --> StyleRule : independent rubric evidence
    StyleRule <|.. LineLength

    note for GameController "Opening is acknowledgement, not rendered combat.<br/>Midterm Continue/Retake explicitly report T10.<br/>Final combat and ending selector are not implemented."
    note for GameState "HP is separate from marks and energy.<br/>Returned snapshots are defensive copies.<br/>Relationships/rewards are persisted data, not playable systems yet."
    note for RuleValues "Null is TBD, never zero.<br/>No production balancing defaults.<br/>Only tests supply fixture values."
    note for ContentCatalog "One Lesson node: ask OR raise hand.<br/>Fixed ordinary questions, supplied major sample size.<br/>No authored course bank is installed."
    note for GradeBook "65 Term / 10 Participation / 25 Final.<br/>Midterm belongs to Term; its weight is supplied explicitly.<br/>First two absences free, then minus one overall percentage point."
    note for AssessmentRecord "Ordinary including makeup: three-day delay.<br/>Midterm and Final: immediate result, no skip.<br/>Evaluator supplies mark; no HP or automatic rubric conversion."
    note for SaveManager "Only active DAY_END snapshots.<br/>Load does not advance or regrant effects.<br/>Ending/Retake autosave boundaries remain T12."
    note for JavaAssessmentRunner "Actual compiler and test processes with time/output limits.<br/>Trusted local code only, not an OS security sandbox.<br/>No automatic course-score rubric."

    note for Main "Entry placeholder only.<br/>No UI, CLI routing, or framework startup.<br/>FXGL and libGDX are prepared by Gradle, not gameplay classes."
