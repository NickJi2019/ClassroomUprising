classDiagram
    direction TB
    %% Design proposal, 2026-11-09. Not implemented Java.
    %% Rules R01-R15 and sole TBD register T01-T14: Sprint1.md, Design Documents.
    class MainMenuController {
        +newGame(String name) void
        +continueGame() boolean
        +showInstructions() void
        +exitGame() void
    }
    class GameUI {
        +showMainMenu() void
        +showInstructions() void
        +showDay(GameState state) void
        +showLesson(DayPlan plan) void
        +showChoice(String kind) void
        +showAssessment(AssessmentSession session) void
        +showResult(AssessmentRecord record) void
        +showFeedback(String message) void
        +showEnding(String outcome) void
    }
    class GameController {
        -GameState state
        +newGame(String name) void
        +continueGame() boolean
        +beginDay() void
        +chooseAttendance(boolean attend, boolean excused) void
        +advancePeriod() boolean
        +chooseSleep() void
        +resolveMidterm(String choice) void
        +finishSemester() void
        +endDay() boolean
    }
    class GameState {
        -StudentState student
        -SchoolCalendar calendar
        -ActionBudget time
        -GradeBook grades
        -ContentProgress content
        -RunProgress run
        -ArrayList~TimedEffect~ effects
        +applyEffects(String sourceId, String context) void
        +replaceEstimateEffects(String assessmentId) void
        +isPenaltyFreeTutorial() boolean
    }
    class StudentState {
        -String name
        -double hp
        -double san
        -double codingVibe
        -double[] unitKnowledge
    }
    class SchoolCalendar {
        -int currentDay
        -DayPeriod period
        -ArrayList~DayPlan~ schedule
        +today() DayPlan
        +makeupCandidates(String assessmentId) ArrayList~DayPlan~
        +recordMakeup(int day, String assessmentId) void
        +advancePeriod() void
        +advanceDay() void
    }
    class DayPlan {
        -int day
        -CourseType course
        -String unitId
        -String assessmentId
        -String makeupAssessmentId
        -String lessonInteractionKind
        -boolean tutorial
    }
    class DayPeriod {
        <<enumeration>>
        MORNING_BONUS
        ICS_CLASS
        OTHER_CLASSES
        AFTER_SCHOOL
        EVENING
        LATE_NIGHT
        DAY_END
    }
    class CourseType {
        <<enumeration>>
        LESSON
        LAB
        UNIT_TEST
        REVIEW
        MIDTERM
        FINAL
    }
    class ActionBudget {
        -double remainingTime
        -boolean nextMorningHalfUnit
        +openPeriod(DayPeriod period) void
        +canSpend(double cost) boolean
        +spend(double cost) void
        +recordEarlySleep() void
        +activityScale() double
    }
    class GradeBook {
        -ArrayList~AssessmentRecord~ records
        -int unexcusedAbsences
        -double participationPoints
        +recordAttendance(boolean excused, boolean tutorial) void
        +recordSubmission(AssessmentRecord record) void
        +returnDueGrades(int day) ArrayList~AssessmentRecord~
        +releaseOfficialGrade(String id) AssessmentRecord
        +applySeriousCheatingZero(String id) void
        +currentAverage() double
        +finalPercentage() double
    }
    class AssessmentRecord {
        -String id
        -CourseType type
        -String unitId
        -String status
        -int submittedDay
        -int officialReturnDay
        -boolean hasEstimate
        -double estimatedScore
        -double officialScore
        -boolean resultEffectsApplied
        -boolean makeup
        -String gradingEvidence
    }
    class AssessmentController {
        -AssessmentSession active
        +start(GameState state, DayPlan plan) void
        +respond(GameState state, String input) void
        +submit(GameState state) AssessmentRecord
        +selfEstimate(GameState state) void
        +useReward(GameState state, String rewardId) void
        +resolveCheating(GameState state, boolean serious) void
    }
    class AssessmentSession {
        -String assessmentId
        -ArrayList~Question~ questions
        -ArrayList~String~ responses
        -String javaSource
        -String battleState
        -boolean makeup
        -String timingState
    }
    class JavaAssessmentRunner {
        +compileAndTest(String source, String assessmentId) String
        +checkStyle(String source, String rubricId) String
    }
    class ActivityController {
        +lessonChoice(GameState state, String choice) void
        +otherClassChoice(GameState state, String choice) void
        +hubChoice(GameState state, String activityId) void
        +peerInteraction(GameState state, String peerId, String choice) void
    }
    class TimedEffect {
        -String sourceId
        -String target
        -int effectiveDay
        -String expiryCondition
        -String valueRule
    }
    class StoryController {
        -StoryEvent activeEvent
        -int sceneIndex
        +playOpening(GameState state) void
        +playDueStories(GameState state) void
        +choose(GameState state, String choice) void
        +hasPendingScene() boolean
    }
    class StoryEvent {
        -String id
        -ArrayList~String~ scenes
        -ArrayList~String~ choices
        -String triggerCondition
        -String effectDefinition
    }
    class ContentCatalog {
        -ArrayList~StoryEvent~ stories
        -ArrayList~Question~ questions
        -ArrayList~Activity~ activities
        +findActivity(String id) Activity
        +questionsFor(DayPlan plan) ArrayList~Question~
    }
    class Activity {
        -String id
        -String availability
        -double normalTimeCost
        -String effectDefinition
    }
    class Question {
        -String id
        -String unitId
        -String prompt
        -String assessmentDefinition
    }
    class ContentProgress {
        -boolean introductionCompleted
        -ArrayList~String~ completedStoryIds
        -ArrayList~String~ unlockedTopicIds
        -Map peerRelationships
    }
    class RunProgress {
        -int retakesUsed
        -String outcome
        -ArrayList~String~ ownedRewardIds
        -ArrayList~String~ newPlaythroughRewardIds
        +hasRetakeOpportunity() boolean
        +recordRetake() void
    }
    class SaveManager {
        +saveAtDayEnd(GameState state) boolean
        +load() GameState
        -validate(GameState state) boolean
    }

    MainMenuController --> GameController : starts or resumes a run
    MainMenuController --> GameUI : menu and instructions
    GameController --> GameUI : presents and accepts input
    GameController "1" --> "0..1" GameState : coordinates active run
    GameController --> ActivityController : class and Hub actions
    GameController --> AssessmentController : assessments
    GameController --> StoryController : narrative and tutorial
    GameController --> SaveManager : day-end boundary only
    GameState "1" *-- "1" StudentState
    GameState "1" *-- "1" SchoolCalendar
    GameState "1" *-- "1" ActionBudget
    GameState "1" *-- "1" GradeBook
    GameState "1" *-- "1" ContentProgress
    GameState "1" *-- "1" RunProgress
    GameState "1" *-- "0..*" TimedEffect
    SchoolCalendar "1" *-- "40" DayPlan : original schedule plus replacements
    SchoolCalendar --> DayPeriod
    DayPlan --> CourseType
    ActionBudget --> DayPeriod
    GradeBook "1" *-- "0..*" AssessmentRecord : only owner of mark records
    AssessmentRecord --> CourseType
    AssessmentController "1" --> "0..1" AssessmentSession
    AssessmentController --> JavaAssessmentRunner : full Java tests and style evidence
    AssessmentController --> ContentCatalog : fixed or sampled questions
    AssessmentController --> GameState : submission and effect coordination
    AssessmentSession "1" --> "1..*" Question
    ActivityController --> ContentCatalog : configured choices
    ActivityController --> GameState : validate time and apply effects
    StoryController --> ContentCatalog : scenes
    StoryController --> GameState : story flags and effects
    StoryController "1" --> "0..1" StoryEvent
    ContentCatalog "1" *-- "0..*" StoryEvent
    ContentCatalog "1" *-- "0..*" Activity
    ContentCatalog "1" *-- "0..*" Question
    SaveManager ..> GameState : includes pending marks and next-day effects

    note for StudentState "HP is not a grade percentage or energy.<br/>Coding Vibe plus unit Knowledge are XP.<br/>HP mapping and SAN influence: T01, T03."
    note for GameState "One effect-application boundary.<br/>All tutorial penalties become warnings only.<br/>Temporary and estimate effects keep their source identity.<br/>Values and estimate replacement: T03, T08, T11."
    note for DayPlan "40-day calendar in Sprint1.md.<br/>Lesson: one post-content choice; ask OR raise hand.<br/>Review details T14; makeup placement T05."
    note for ActionBudget "ICS and OTHER_CLASSES: one unit each.<br/>Hub: after school, evening, late night.<br/>Early sleep: next-morning 0.5 unit and SAN bonus.<br/>Half activity values; discrete details T04."
    note for GradeBook "65 percent Term, 10 Participation, 25 Final.<br/>Midterm belongs to Term; its relative weight is TBD.<br/>Unit Lab and Unit Test equal weight.<br/>After two free absences: minus 1 overall percentage point each.<br/>Excused leave is exempt. Formulas and limits: T02."
    note for AssessmentRecord "Ordinary results: three days after submission.<br/>Midterm and Final: immediate official result.<br/>Estimated and official marks stay distinct.<br/>Submission is not result release; T05, T08."
    note for AssessmentController "No skipping Midterm or Final.<br/>Final: turn-based question combat. Other formats T01.<br/>Caught cheating: large SAN loss; serious: this mark becomes zero.<br/>Makeup: same questions, no lesson bonus, SAN debuff,<br/>no peeking, higher detection risk. Details T05, T09."
    note for JavaAssessmentRunner "Planned capability, not an existing service.<br/>Compiler, limits, test/rubric scoring and failure handling: T06."
    note for TimedEffect "Late night lowers next-day SAN and XP gain multiplier.<br/>Self-estimate effects are provisional until official return.<br/>No unspecified magnitude or stacking formula: T03, T08."
    note for RunProgress "Two Retakes; back to Day 1, keep XP, initial SAN debuff.<br/>Retake count must survive the reset.<br/>New playthrough keeps selected rewards only, not XP.<br/>Other reset data and ending priority: T10."
    note for ContentProgress "Persistent shallow peer relationships: T13.<br/>No other-subject Knowledge stat."
    note for SaveManager "Only save at day end.<br/>Retake/ending boundary, resume and failure rules: T12."
