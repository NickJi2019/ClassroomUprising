<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.aphs.classroomuprising.ui.ChoiceList?>
<?import com.aphs.classroomuprising.ui.DialogueBox?>
<?import com.aphs.classroomuprising.ui.Hud?>
<?import com.aphs.classroomuprising.ui.scene.SceneView?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="screen, classroom">
    <SceneView fx:id="scene"/>
    <AnchorPane pickOnBounds="false">
        <Region styleClass="scrim-bottom" mouseTransparent="true" prefHeight="300.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0"/>
        <Region styleClass="scrim-right" mouseTransparent="true" prefWidth="640.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"/>

        <VBox spacing="14" alignment="TOP_RIGHT" prefWidth="470.0"
              AnchorPane.rightAnchor="56.0" AnchorPane.topAnchor="170.0">
            <Label fx:id="prompt" styleClass="display, side-prompt" wrapText="true" alignment="CENTER_RIGHT"/>
            <ChoiceList fx:id="choices" alignment="TOP_RIGHT"/>
            <VBox fx:id="notice" maxWidth="470.0"/>
        </VBox>

        <DialogueBox fx:id="dialogue" prefHeight="150.0"
                     AnchorPane.leftAnchor="290.0" AnchorPane.rightAnchor="40.0" AnchorPane.bottomAnchor="40.0"/>
    </AnchorPane>
    <Hud fx:id="hud"/>
</StackPane>
