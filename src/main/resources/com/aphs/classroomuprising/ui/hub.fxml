<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.aphs.classroomuprising.ui.ChoiceList?>
<?import com.aphs.classroomuprising.ui.Hud?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="screen, hub">
    <AnchorPane pickOnBounds="false">
        <Label fx:id="place" styleClass="display, place-kicker" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="170.0"/>
        <ChoiceList fx:id="options" styleClass="large" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="215.0"/>

        <VBox styleClass="detail-card" spacing="10" prefWidth="440.0"
              AnchorPane.rightAnchor="70.0" AnchorPane.topAnchor="215.0">
            <Label fx:id="detailTitle" styleClass="display, detail-title"/>
            <Label fx:id="detailCost" styleClass="detail-cost"/>
            <FlowPane fx:id="detailEffects" hgap="8" vgap="8"/>
            <Label fx:id="detailCaution" styleClass="mono, detail-caution" wrapText="true"/>
        </VBox>

        <VBox fx:id="notice" maxWidth="440.0" AnchorPane.rightAnchor="70.0" AnchorPane.bottomAnchor="60.0"/>
    </AnchorPane>
    <Hud fx:id="hud"/>
</StackPane>
