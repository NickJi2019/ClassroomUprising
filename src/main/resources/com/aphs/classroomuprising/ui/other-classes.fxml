<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.aphs.classroomuprising.ui.ChoiceList?>
<?import com.aphs.classroomuprising.ui.Hud?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="screen, other-classes">
    <AnchorPane pickOnBounds="false">
        <VBox spacing="6" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="170.0">
            <Label text="OTHER CLASSES" styleClass="display, place-title"/>
            <Label text="Not ICS4U. How do you spend the period?" styleClass="place-sub"/>
        </VBox>
        <ChoiceList fx:id="choices" styleClass="large" AnchorPane.leftAnchor="80.0" AnchorPane.topAnchor="290.0"/>
        <VBox fx:id="notice" maxWidth="520.0" AnchorPane.rightAnchor="60.0" AnchorPane.bottomAnchor="60.0"/>
    </AnchorPane>
    <Hud fx:id="hud"/>
</StackPane>
